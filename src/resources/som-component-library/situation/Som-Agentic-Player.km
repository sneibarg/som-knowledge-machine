;; Som-Agentic-Player.km
;; One agentic player. This situation partitions that player's assertions
;; and the answers computed from them.

(Som-Agentic-Player has
  (superclasses (Situation)))

(som-bootstrap has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("bootstrap has completed")))
