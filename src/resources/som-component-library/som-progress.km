;; som-progress.km
;; The view is drawn from one projection. The projection is not the stored clock.

(som-progress has
  (instance-of (Slot))
  (domain (Thing))
  (range (Som-Progress-Projection))
  (inverse (som-progress-of))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (original-slot (t)))

(som-progress has (text-gloss ("is drawn from")))

(som-progress-of has
  (instance-of (Slot))
  (fluent-status (*Fluent))
  (text-gloss ("is the progress of")))
