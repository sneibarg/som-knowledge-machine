;; Som-Route.km
;; The exits to take from one explored room to another.
;; The caller asserts som-route-from and som-route-to.
;; som-route-exits is the :seq of exits in the order to take them.
;; The same room at both ends is (:seq). No connection leaves the slot
;; empty.
;;
;; Each room contributes the first exit, in the room's listed order,
;; whose far room is the destination or can continue to it. An exit
;; back to the room already being searched is skipped. An exit whose
;; far room is not on the situation's som-explored-room seq is skipped.
;; som-requires-open and som-requires-unlock stay on the exit. This
;; conclusion does not add a command for either flag.
;;
;; The two conclusion slots are not cached. After the exits change,
;; the caller asks with a new route.

(Som-Route has
  (superclasses (Thing)))

(som-route-from has (instance-of (Slot)) (cardinality (N-to-1)) (fluent-status (*Fluent)) (text-gloss ("the explored room the route starts from")))
(som-route-to has (instance-of (Slot)) (cardinality (N-to-1)) (fluent-status (*Fluent)) (text-gloss ("the explored room the route reaches")))
(som-route-found has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (dont-cache-values (t))
  (text-gloss ("exit sequences that reach the destination, in exit order")))
(som-route-found-rule has (instance-of (Slot)) (cardinality (N-to-1)) (fluent-status (*Fluent)) (text-gloss ("the rule for som-route-found")))
(som-route-exits has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (dont-cache-values (t))
  (text-gloss ("the exits to take, in order")))
(som-route-exits-rule has (instance-of (Slot)) (cardinality (N-to-1)) (fluent-status (*Fluent)) (text-gloss ("the rule for som-route-exits")))

(every Som-Route has
  (som-route-found ((the som-route-found-rule of Self)))
  (som-route-exits ((the som-route-exits-rule of Self)))

  (som-route-found-rule
    ((if ((has-value (the som-route-from of Self))
          and
          (has-value (the som-route-to of Self))
          and
          (not ((the som-route-from of Self) = (the som-route-to of Self)))
          and
          (has-value (the som-room-exit of (the som-route-from of Self)))
          and
          (not ((the som-room-exit of (the som-route-from of Self)) = (:seq)))
          and
          (has-value (the som-explored-room of (curr-situation)))
          and
          (not ((the som-explored-room of (curr-situation)) = (:seq))))
         then (forall-seq ?e in (the som-room-exit of (the som-route-from of Self))
                          where ((has-value (the som-exit-to of ?e))
                                 and
                                 (not ((the som-exit-to of ?e)
                                       = (the som-route-from of Self)))
                                 and
                                 ((the seq-length of
                                   (forall-seq ?r in (the som-explored-room of (curr-situation))
                                               where (?r = (the som-exit-to of ?e))
                                               ?r))
                                  > 0)
                                 and
                                 (((the som-exit-to of ?e) = (the som-route-to of Self))
                                  or
                                  ((has-value (the som-route-found of
                                               (the+ Som-Route with
                                                 (som-route-from ((the som-exit-to of ?e)))
                                                 (som-route-to ((the som-route-to of Self))))))
                                   and
                                   (not ((the som-route-found of
                                          (the+ Som-Route with
                                            (som-route-from ((the som-exit-to of ?e)))
                                            (som-route-to ((the som-route-to of Self)))))
                                         = (:seq))))))
                          (if ((the som-exit-to of ?e) = (the som-route-to of Self))
                              then (:seq ?e)
                              else ((:seq ?e) append
                                    (the1 of (the som-route-found of
                                              (the+ Som-Route with
                                                (som-route-from ((the som-exit-to of ?e)))
                                                (som-route-to ((the som-route-to of Self))))))))))))

  (som-route-exits-rule
    ((if ((has-value (the som-route-from of Self))
          and
          (has-value (the som-route-to of Self))
          and
          ((the som-route-from of Self) = (the som-route-to of Self)))
         then (:seq)
         else (if ((has-value (the som-route-found of Self))
                   and
                   (not ((the som-route-found of Self) = (:seq))))
                  then (the1 of (the som-route-found of Self)))))))
