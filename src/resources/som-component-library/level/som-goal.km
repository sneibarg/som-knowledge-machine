;; som-goal.km
;; The view is judged against one level goal. The goal is not core Goal.

(som-goal has
  (instance-of (Slot))
  (domain (Thing))
  (range (Som-Level-Goal))
  (inverse (som-goal-of))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (original-slot (t)))

(som-goal has (text-gloss ("is judged against")))

(som-goal-of has
  (instance-of (Slot))
  (fluent-status (*Fluent))
  (text-gloss ("is the goal of")))
