  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the position word on the latest score")))

(som-areas-known has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("at least one area record is stored")))

(som-fighting has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the engine says the character is fighting")))

