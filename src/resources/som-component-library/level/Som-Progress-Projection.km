  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("met was already stored")))

(som-deadline-in has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("deadline missed was already stored")))

(som-max-hit has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("max hit on the latest score, if that page printed it")))

(som-hit has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("hit points the engine is using for this step")))

