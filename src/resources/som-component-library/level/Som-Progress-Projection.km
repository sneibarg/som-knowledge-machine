  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the engine has seen a kill in this room")))

(som-room-stale has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the session room record needs another look")))

(som-gear-gate has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the gear gate the engine copied, or empty")))

(som-flee-floor has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("play.flee_hp as copied by the engine. Empty means the bold line is not applied")))

(som-untried-exits has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("exits this process has not taken")))
