;; Som-Progress-Projection.km
;; One projection of WorkingMemory's goal section. Discarded after the query.
;; Input slots only. No rule writes an input slot.

(Som-Progress-Projection has
  (superclasses (Thing)))

(som-event has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the event this projection answers")))

(som-clock-kind has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the kind stored on the clock")))

(som-clock-target has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the target stored on the clock")))

(som-start-level has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the level on the first score")))

(som-start-fraction has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the fraction on the first score")))

(som-level has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the level on the latest score")))

(som-exp-to-level has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("experience to level on the latest score page")))

(som-exp-span has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("experience span taken from the first score on this level")))

(som-exp-estimate has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("experience to level after a receive line, before the next score")))

(som-score-page-exp has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("experience to level on a score page that replaces the estimate")))

(som-elapsed-minutes has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("minutes since the first score")))

(som-score-count has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("scores already folded into this projection")))

(som-first-score has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("this score is the first one on the clock")))

(som-prior-notch has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the notch stored before this event")))

(som-cooldown-steps has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("cooldown steps still stored")))

(som-saves has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("checkpoints stored on this level")))

(som-score-steps has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("steps since the last score. Python stores 0 after a score is folded in")))

(som-score-forced has
  (instance-of (Slot))
  (cardinality (N-to-1))
  (fluent-status (*Fluent))
  (text-gloss ("the engine marked a score due, as after a fight")))

