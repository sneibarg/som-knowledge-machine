{:paths ["src"]
 ;; Libraries resolve through Maven Central. Ring is published on Clojars,
 ;; which this environment's Nexus mirror does not serve, so the HTTP
 ;; service uses the JDK server. See docs/migration/00-project-shell.md.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :repl {:main-opts ["-m" "som.km.repl"]}
  :server {:main-opts ["-m" "som.km.server"]}}}
